<!DOCTYPE html>
<html lang="en">
<head>
    <!--
        Author: Valentin Esparza
        Date: 8/9/2026
        Purpose: Checkout page — shipping details, insurance option, payment placeholder.
    -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout — The Gilded Panel</title>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>

    <header class="site-header">
        <div class="container">
            <a class="brand" href="index.html">THE GILDED PANEL</a>
            <nav class="main-nav" aria-label="Primary">
                <ul>
                    <li><a href="shop.html">Shop</a></li>
                    <li><a href="about.html">About</a></li>
                    <li><a href="account.html">Account</a></li>
                    <li><a href="cart.html">Cart</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <section class="container">
            <h1>Checkout</h1>
            <form class="stack" action="confirmation.html">
                <fieldset>
                    <legend>Shipping Details</legend>
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" required>

                    <label for="address">Shipping Address</label>
                    <input type="text" id="address" name="address" required>
                </fieldset>

                <fieldset>
                    <legend>Shipping &amp; Insurance</legend>
                    <label for="shipping">Shipping Tier</label>
                    <select id="shipping" name="shipping">
                        <option value="standard">Standard (Insured up to $100)</option>
                        <option value="premium">Premium (Fully Insured)</option>
                    </select>
                </fieldset>

                <fieldset>
                    <legend>Payment</legend>
                    <label for="card">Card Number</label>
                    <input type="text" id="card" name="card" placeholder="Payment processing not yet implemented" disabled>
                </fieldset>

                <button type="submit" class="btn btn-crimson">Place Order</button>
            </form>
        </section>

    </main>

    <footer class="site-footer">
        <p>&copy; 2026 The Gilded Panel &middot; <a href="about.html">About</a> &middot; <a href="about.html">Contact</a></p>
    </footer>

</body>
</html>
