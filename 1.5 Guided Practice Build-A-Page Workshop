<!DOCTYPE html>
<html lang="en">

<head>
    <!--
        Author: Valentin Esparza
        Date: 7/29/26
        Purpose: create the basic structure of a webpage.
    -->

    <!-- Character encoding ensures proper text rendering -->
    <meta charset="UTF-8">
    <!-- Enables responsive behavior on mobile devices -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Build-A-Page</title>
</head>

<body>

    <!-- STEP 1 -->
    <header>
        <h1>Build-A-Page Workshop</h1>
        <p>Structure your web page experience!</p>
    </header>
    <!-- STEP 2 -->
    <nav>
        <ul>
            <li><a href="#home">Main</a></li>
            <li><a href="#table">Table</a></li>
            <li><a href="#form">Form</a></li>
        </ul>
    </nav>
    <!-- STEP 3 -->
    <main id="home"></main>
    <!-- STEP 4 -->
    <section>
        <h2>Feature Comparison</h2>
        <table border="1" id="table">
            <tr>
                <th>Feature</th>
                <th>Basic</th>
                <th>Deluxe</th>
            </tr>
            <tr>
                <td>Custom Header</td>
                <td>Yes</td>
                <td>Yes</td>
            </tr>
            <tr>
                <td>Navigation Menu</td>
                <td>Yes</td>
                <td>Yes</td>
            </tr>
            <tr>
                <td>Interactive Form</td>
                <td>No</td>
                <td>Yes</td>
            </tr>
        </table>
    </section>
    <!-- STEP 5 -->
    <section>
        <h2>Customization Options</h2>
        <ul>
            <li>Color Themes</li>
            <li>Font Styles</li>
            <li>Layout Choices</li>
        </ul>
    </section>
    <!-- STEP 6 -->
    <aside>
        <h3>Builder Tip</h3>
        <p>Use semantic HTML to keep your page organized and accessible.</p>
    </aside>
    <!-- STEP 7 -->
    <section>
        <h2>Design Preferences</h2>
        <form id="form">
            <label for="name">Page Name:</label>
            <input type="text" id="name" name="name"><br><br>
            <label for="theme">Choose a Theme:</label>
            <select id="theme" name="theme">
                <option>Light</option>
                <option>Dark</option>
                <option>Colorful</option>
            </select><br><br>
            <button type="submit">Submit Preferences!</button>
        </form>
    </section>
    <!-- STEP 8 -->
    <p>Page built on <time datetime="YEAR-MM-DD">TODAY</time></p>
    <!-- STEP 9 -->
    <footer>
        <p>&copy; YEAR Build-A-Page Workshop</p>
        <p>Created by STUDENT_ID</p>
    </footer>
    </main>
</body>

</html>
